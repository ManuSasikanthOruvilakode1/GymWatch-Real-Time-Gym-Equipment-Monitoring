# Private, self-collected data: never commit.
# Only the folder skeleton (README.md / .gitkeep placeholders) is tracked.
/data/**
!/data/*/
!/data/README.md
!/data/*/.gitkeep
/video/**
!/video/README.md
*.mov
*.mp4
*.jpg
*.jpeg
*.h5

# Generated
/.cache/
/runs/
/artifacts/
/models/**
!/models/README.md
*.onnx
*.pt
*.sqlite*

# Figures that contain photos from the private dataset
/docs/figures/private/

# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
